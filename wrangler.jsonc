{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koreamagic-webzine",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kms-magic-webzine-db",
      "database_id": "77262834-f2f3-4ede-8ba7-0c15a9a15784",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *",
      "0 0 1 * *"
    ]
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "SITE_TITLE": "한국마술학회 AI 웹진"
  }
}
